HONEYBADGER_API_KEY_BACKEND=
HONEYBADGER_API_KEY_FRONTEND=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
API_KEY=                 # shared secret for the x-api-key header
SOCRATA_APP_TOKEN=
