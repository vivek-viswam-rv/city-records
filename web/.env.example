# Base URL of the API. Default "/api" (proxied by Vite in dev, Vercel rewrite in prod).
VITE_API_URL=/api
# Optional: sent as x-api-key header
VITE_API_KEY=
# Set to 1 to use built-in mock data (no API needed)
VITE_USE_MOCK=1
# Optional: enables Honeybadger error reporting
VITE_HONEYBADGER_API_KEY=
